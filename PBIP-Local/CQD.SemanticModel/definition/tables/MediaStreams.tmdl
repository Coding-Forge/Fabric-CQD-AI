		lineageTag: 5e30a08d-7e80-47b7-8651-a06b09efac33
		summarizeBy: average
		sourceColumn: AvgConcealedRatio

	column MaxConcealedRatio
		dataType: double
		lineageTag: a4bdcec9-ba90-4eee-b40b-9257902b2f86
		summarizeBy: max
		sourceColumn: MaxConcealedRatio

	column AvgAudioDegradation
		dataType: double
		lineageTag: 3a493b31-ce94-4058-b7f4-a6ec878012b4
		summarizeBy: average
		sourceColumn: AvgAudioDegradation

	column PacketUtilization
		dataType: int64
		lineageTag: 44a747b6-f54b-4944-8bbc-8aa9099c8baa
		summarizeBy: sum
		sourceColumn: PacketUtilization

	column CallerConnectionType
		dataType: string
		lineageTag: f469d197-8fcf-4fa3-ae03-6903aa85f64e
		summarizeBy: none
		sourceColumn: CallerConnectionType

	column CallerWifiBand
		dataType: string
		lineageTag: fef8e000-5580-4c5d-99db-c480e92a9eba
		summarizeBy: none
		sourceColumn: CallerWifiBand

	column CalleeConnectionType
		dataType: string
		lineageTag: 408365f6-6236-4014-8aa8-949d8007b7f8
		summarizeBy: none
		sourceColumn: CalleeConnectionType

	column CalleeWifiBand
		dataType: string
		lineageTag: f7deae14-804a-439b-86fd-6f7b4dd8bd4b
		summarizeBy: none
		sourceColumn: CalleeWifiBand

	column TransportProtocol
		dataType: string
		lineageTag: d82f87f1-6105-465f-8955-66298a9e5931
		summarizeBy: none
		sourceColumn: TransportProtocol

	column StreamQuality =
			SWITCH(
			    TRUE(),
			    ISBLANK(MediaStreams[AvgJitterMs]) && ISBLANK(MediaStreams[AvgRoundTripMs]) && ISBLANK(MediaStreams[AvgPacketLossRate]), "No data",
			    MediaStreams[AvgPacketLossRate] > 0.1 || MediaStreams[AvgRoundTripMs] > 500 || MediaStreams[AvgJitterMs] > 30 || MediaStreams[AvgAudioDegradation] > 1, "Poor",
			    MediaStreams[AvgPacketLossRate] > 0.05 || MediaStreams[AvgRoundTripMs] > 300 || MediaStreams[AvgJitterMs] > 15, "Fair",
			    "Good"
			)
		dataType: string
		lineageTag: af5f7db0-6b35-44b1-aad3-2d6a3ff82fe2
		summarizeBy: none

	partition MediaStreams = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SamplesFolder & "\MediaStreams.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CallId", type text}, {"SessionId", type text}, {"SegmentId", type text}, {"StreamId", type text}, {"MediaLabel", type text}, {"Direction", type text}, {"AudioCodec", type text}, {"VideoCodec", type text}, {"AvgJitterMs", type number}, {"MaxJitterMs", type number}, {"AvgRoundTripMs", type number}, {"MaxRoundTripMs", type number}, {"AvgPacketLossRate", type number}, {"MaxPacketLossRate", type number}, {"AvgConcealedRatio", type number}, {"MaxConcealedRatio", type number}, {"AvgAudioDegradation", type number}, {"PacketUtilization", Int64.Type}, {"CallerConnectionType", type text}, {"CallerWifiBand", type text}, {"CalleeConnectionType", type text}, {"CalleeWifiBand", type text}, {"TransportProtocol", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table


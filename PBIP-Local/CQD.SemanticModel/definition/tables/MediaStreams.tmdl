table MediaStreams
	lineageTag: 6b0d3c1e-5a52-4d0e-9a53-0f3c9d1b0005

	measure 'Stream Count' = COUNTROWS(MediaStreams)
		formatString: 0
		lineageTag: 4e0bb9a7-e96b-48ea-8afb-65a70ea3439e

	measure 'Avg Jitter (ms)' = AVERAGE(MediaStreams[AvgJitterMs])
		formatString: 0.0
		lineageTag: d3b34d57-f67b-40b6-8a86-ef8c7cc69c8d

	measure 'Max Jitter (ms)' = MAX(MediaStreams[MaxJitterMs])
		formatString: 0.0
		lineageTag: 217487df-27c9-4050-8c30-29014e38a029

	measure 'Avg Round Trip (ms)' = AVERAGE(MediaStreams[AvgRoundTripMs])
		formatString: 0.0
		lineageTag: 3d24109b-4eb5-4fea-8424-7d9c9e326715

	measure 'Avg Packet Loss %' = AVERAGE(MediaStreams[AvgPacketLossRate])
		formatString: 0.00%
		lineageTag: d5021e90-8d37-4e87-aa2f-658ffd53bcfd

	measure 'Max Packet Loss %' = MAX(MediaStreams[MaxPacketLossRate])
		formatString: 0.00%
		lineageTag: 916b2b76-6c87-4df1-8596-75cbf869f744

	measure 'Avg Concealed Samples %' = AVERAGE(MediaStreams[AvgConcealedRatio])
		formatString: 0.00%
		lineageTag: 13ea89c1-7bc2-4570-8c97-3951724027d1

	measure 'Poor Streams (loss >10% or RTT >500ms)' = CALCULATE(COUNTROWS(MediaStreams), FILTER(MediaStreams, MediaStreams[AvgPacketLossRate] > 0.1 || MediaStreams[AvgRoundTripMs] > 500))
		formatString: 0
		lineageTag: e577bab1-c87c-4dd3-b02f-ebe56170f182

	measure 'Good Stream %' = DIVIDE(CALCULATE(COUNTROWS(MediaStreams), MediaStreams[StreamQuality] = "Good"), CALCULATE(COUNTROWS(MediaStreams), MediaStreams[StreamQuality] <> "No data"))
		formatString: 0.0%
		lineageTag: 56966c40-ee8c-4f17-a85d-0d6b69acc5eb

	column CallId
		dataType: string
		lineageTag: d27dac14-487d-4dc0-a9bc-81346270c8ec

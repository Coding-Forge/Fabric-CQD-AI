	column FailureReason
		dataType: string
		lineageTag: 856fe7ad-a1fb-49c9-8d65-bd9cb20859de
		summarizeBy: none
		sourceColumn: FailureReason

	partition Sessions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SamplesFolder & "\Sessions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CallId", type text}, {"SessionId", type text}, {"Modalities", type text}, {"StartDateTime", type datetimezone}, {"EndDateTime", type datetimezone}, {"DurationSeconds", type number}, {"CallerKey", type text}, {"CallerPlatform", type text}, {"CallerProduct", type text}, {"CalleePlatform", type text}, {"CalleeProduct", type text}, {"FailureStage", type text}, {"FailureReason", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

